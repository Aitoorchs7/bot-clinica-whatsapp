# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio.
# Ninguna clave de este archivo debe llevar valor aquí.

# --- Supabase (proyecto en región EU / Frankfurt, por RGPD) ---
# URL pública del proyecto. Se expone al navegador.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima. Se expone al navegador: solo sirve con RLS activada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio. SOLO servidor: migraciones y scripts de alta.
# Jamás en el navegador, jamás con prefijo NEXT_PUBLIC_, jamás en el
# camino del bot.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto JWT del proyecto (Settings > API > JWT Settings). Firma el token con
# el que corre el bot: app_metadata {rol:'bot', clinica_id}, 5 minutos de vida.
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_JWT_SECRET=
# Referencia del proyecto (la parte <ref> de https://<ref>.supabase.co).
# La usa `supabase gen types` para regenerar src/tipos/bd.ts.
SUPABASE_PROJECT_REF=

# --- Google AI Studio ---
# Una sola clave cubre las tres cosas, todas en el tier gratuito:
#   gemini-3.6-flash        -> cerebro del bot
#   gemini-3.1-flash-lite   -> clasificador de urgencia y escalado
#   gemini-embedding-001    -> embeddings de la FAQ (768 dims)
#
# Antes eran gemini-2.5-flash y gemini-2.5-flash-lite: devuelven 404 con una
# clave nueva («no longer available to new users»), medido el 18/09/2026 por
# tests/bot-contrato. PLAN.md y .claude/CLAUDE.md ya dicen los de arriba.
# El porqué y los diez candidatos probados, en ESTADO_F3 §7.1.
GOOGLE_AI_API_KEY=

# --- Interruptores solo de pruebas (no son secretos) ---
# GEMINI_VIVO=1 enciende tests/bot-contrato, que llama a Gemini DE VERDAD y
# gasta cuota del tier gratuito, que es diaria. Apagado, `pnpm test` no hace ni
# una peticion al modelo. No hace falta ponerlo en .env.local: va delante del
# comando.  ->  GEMINI_VIVO=1 pnpm vitest run tests/bot-contrato

# --- Deepgram (transcripción de notas de voz, nova-3 en español) ---
DEEPGRAM_API_KEY=

# --- WhatsApp Business Cloud API (Meta, oficial) ---
# Token permanente del System User de Meta Business. Sirve para DOS cosas:
# enviar mensajes y descargar las notas de voz (las dos peticiones de la
# descarga lo llevan, también la del CDN).
WHATSAPP_TOKEN=
# ID del número de teléfono de la clínica dentro de la WABA.
WHATSAPP_PHONE_NUMBER_ID=
# Cadena que inventamos nosotros; Meta la devuelve al dar de alta el
# webhook y debe coincidir.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta. Verifica la firma X-Hub-Signature-256 sobre
# el cuerpo CRUDO de cada webhook.
# OJO: NO es el mismo valor que WHATSAPP_TOKEN, y confundirlos falla de forma
# distinta en cada dirección: firmar con el token da 401 en todos los webhooks;
# enviar con el app secret da 190.
META_APP_SECRET=
# De qué clínica es cada webhook: {"<phone_number_id>":"<clinica_id>"}.
# Vive aquí y no en la base de datos porque la RLS del rol `bot` exige saber ya
# de qué clínica eres antes de poder leer nada, y resolverlo con una consulta
# sin identidad exigiría service_role, que no entra en el camino del bot.
# Después se COMPRUEBA contra clinicas.wa_phone_number_id. Ver ESTADO_F4 §3.
WHATSAPP_CLINICAS=
# Versión de la Graph API. Sin valor usa la clavada en código (v25.0).
# Se fija a una versión y no a un alias por el mismo motivo que los modelos de
# Gemini: un cambio silencioso es peor que un fallo ruidoso.
GRAPH_API_VERSION=
# Cuánto espera el debounce antes de contestar, en milisegundos. Sin valor,
# 8000. La gente manda cuatro mensajes seguidos y el bot contesta una vez.
WHATSAPP_DEBOUNCE_MS=

# --- Aviso al equipo por email cuando el bot escala ---
# Proveedor de correo (Resend, por HTTP, sin dependencia nueva). Si faltan, el
# aviso por WhatsApp sale igual y el fallo queda escrito en el registro: un
# entorno sin correo no puede romper el canal.
RESEND_API_KEY=
EMAIL_REMITENTE=

# --- Coste por token (opcional) ---
# Euros por millón de tokens, para rellenar mensajes.coste_eur. Sin valor, 0,
# que es lo correcto mientras Gemini corra en el tier gratuito. Un 0 explícito
# no es lo mismo que un null: «no costó nada» y «no lo hemos medido» son cosas
# distintas y el panel tendrá que distinguirlas.
GEMINI_EUR_POR_MTOKEN_ENTRADA=
GEMINI_EUR_POR_MTOKEN_SALIDA=

# --- Trabajos programados ---
# Secreto compartido que autentica las llamadas de Vercel Cron. Vercel lo manda
# como `Authorization: Bearer <valor>` en cada disparo.
# SIN ESTA VARIABLE LAS TRES RUTAS DE CRON CONTESTAN 401 A TODO EL MUNDO, y es
# deliberado: un despliegue mal configurado que no manda recordatorios se nota;
# uno en el que cualquiera con la URL puede dispararlos, no.
CRON_SECRET=
# Con cuánta antelación se avisa de una cita, en horas. Sin valor, 24.
# TIENE QUE SER MAYOR QUE EL HUECO ENTRE DOS PASADAS DEL CRON. El que impide
# mandar dos veces es el índice único de la base, no la puntualidad del reloj,
# así que una ventana ancha que se solape entre pasadas es segura; una estrecha
# hace que un cron que se salta una pasada deje a esos pacientes sin aviso.
#   vercel.json dispara /api/cron/recordatorios cada hora -> 24 va sobrado.
#   Si se despliega en un plan de Vercel que solo admite crons DIARIOS, hay que
#   poner 48 aquí y cambiar el horario a diario; si no, las citas de dentro de
#   entre 24 y 48 horas no reciben nada.
RECORDATORIO_HORAS_ANTES=

# --- Panel (F5) ---
# El panel no necesita NI UNA variable nueva: entra con la misma clave anónima
# de arriba, y quien decide lo que ve cada usuario es la RLS a partir de su
# `app_metadata`. Si algún día hiciera falta algo aquí, conviene mirar dos
# veces: un panel que necesita un secreto propio suele ser un panel que se ha
# saltado la RLS.
#
# Lo único, y es de pruebas: el puerto donde Playwright levanta la aplicación
# para `pnpm test:e2e`. Por defecto 3210, para no chocar con `pnpm dev`.
# PUERTO_E2E=3210
